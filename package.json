{
  "name": "invoice-engine",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build:sample": "tsx tools/build-sample.ts",
    "build:fixtures": "tsx tools/build-fixtures.ts",
    "validate": "node tools/py.mjs tools/validate.py && node tools/py.mjs tools/pdfa_audit.py",
    "schematron:compile": "bash tools/compile-schematron.sh",
    "saxonjs:fetch": "node tools/fetch-saxonjs.mjs",
    "cli": "tsx packages/cli/src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "happy-dom": "^20.14.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1"
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@invoice-engine/core": ["./packages/core/src/index.ts"],
      "@invoice-engine/formats": ["./packages/formats/src/index.ts"],
      "@invoice-engine/pdf": ["./packages/pdf/src/index.ts"],
      "@invoice-engine/validate": ["./packages/validate/src/index.ts"],
      "@invoice-engine/validate/browser": ["./packages/validate/src/browser.ts"],
      "@invoice-engine/validate/coverage": ["./packages/validate/src/coverage.ts"],
      "@invoice-engine/cli": ["./packages/cli/src/cli.ts"],
      "@invoice-engine/parse": ["./packages/parse/src/index.ts"],
      "@invoice-engine/compliance-data": ["./packages/compliance-data/src/index.ts"]
    },
    "baseUrl": "."
  },
  "include": ["packages/*/src/**/*.ts", "tools/**/*.ts", "test/**/*.ts", "e2e/**/*.ts", "playwright.config.ts"],
  // pdfjsWorker.ts uses Vite's `?url` import convention, typed only by
  // vite/client (which this Node-context config deliberately doesn't set,
  // since it also checks tools/ and test/, which run under Node, not Vite).
  // packages/ui's own tsconfig.app.json (chained after this one in the root
  // "typecheck" script) has vite/client and checks this file correctly.
  "exclude": ["packages/ui/src/pdfjsWorker.ts"]
}

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@conformo/core": ["./packages/core/src/index.ts"],
      "@conformo/formats": ["./packages/formats/src/index.ts"],
      "@conformo/pdf": ["./packages/pdf/src/index.ts"],
      "@conformo/validate": ["./packages/validate/src/index.ts"],
      "@conformo/validate/browser": ["./packages/validate/src/browser.ts"],
      "@conformo/validate/coverage": ["./packages/validate/src/coverage.ts"],
      "@conformo/cli": ["./packages/cli/src/cli.ts"],
      "@conformo/parse": ["./packages/parse/src/index.ts"],
      "@conformo/compliance-data": ["./packages/compliance-data/src/index.ts"]
    },
    "baseUrl": "."
  },
  "include": ["packages/*/src/**/*.ts", "tools/**/*.ts", "test/**/*.ts", "e2e/**/*.ts", "playwright.config.ts"],
  // pdfjsWorker.ts uses Vite's `?url` import convention, typed only by
  // vite/client (which this Node-context config deliberately doesn't set,
  // since it also checks tools/ and test/, which run under Node, not Vite).
  // Nothing else needs excluding here: every other Vite-only need
  // (VITE_BASE_PATH's import.meta.env.BASE_URL) goes through baseUrl.ts's
  // own local type assertion instead of the global vite/client augmentation
  // — found the hard way, since a file reachable via import from an
  // included plain-.ts file gets type-checked by this pass regardless of
  // being listed here itself; exclude only stops a file from being an
  // *entry point*, not from being pulled in transitively. packages/ui's and
  // packages/validator-page's own tsconfig.json (both chained after this
  // one in the root "typecheck" script) have vite/client and check
  // pdfjsWorker.ts correctly.
  "exclude": ["packages/ui/src/pdfjsWorker.ts"]
}

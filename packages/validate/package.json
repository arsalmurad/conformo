{
  "name": "@conformo/validate",
  "version": "0.1.1",
  "description": "Validates EN 16931 electronic invoices against the official CEN Schematron (plus country CIUS rules), in Node or a browser.",
  "author": "Muhammad Arsal Murad",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arsalmurad/conformo.git",
    "directory": "packages/validate"
  },
  "homepage": "https://github.com/arsalmurad/conformo/tree/main/packages/validate#readme",
  "keywords": [
    "schematron",
    "en16931",
    "validation",
    "e-invoicing",
    "xrechnung",
    "peppol",
    "factur-x"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts",
    "./coverage": "./src/coverage.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('artefacts','dist/artefacts',{recursive:true})\" && node ../../tools/write-dist-manifest.mjs ."
  },
  "dependencies": {
    "saxon-js": "^2.7.0"
  }
}

{
  "name": "@conformo/toolkit",
  "version": "0.2.0",
  "description": "One-call API for EN 16931 e-invoices in Node: create (XML, Factur-X/ZUGFeRD PDF), validate, convert, parse, explain rules, country requirements. The layer the CLI, MCP server and HTTP API share.",
  "author": "Muhammad Arsal Murad",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arsalmurad/conformo.git",
    "directory": "packages/toolkit"
  },
  "homepage": "https://github.com/arsalmurad/conformo/tree/main/packages/toolkit#readme",
  "keywords": [
    "invoice",
    "en16931",
    "e-invoicing",
    "xrechnung",
    "zugferd",
    "factur-x",
    "peppol"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "node ../../tools/clean-dist.mjs && tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('../../assets','dist/assets',{recursive:true})\" && node ../../tools/write-dist-manifest.mjs ."
  },
  "dependencies": {
    "@conformo/compliance-data": "^0.2.0",
    "@conformo/core": "^0.2.0",
    "@conformo/formats": "^0.2.0",
    "@conformo/parse": "^0.2.0",
    "@conformo/pdf": "^0.2.0",
    "@conformo/validate": "^0.2.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1"
  }
}

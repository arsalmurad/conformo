{
  "name": "@conformo/mcp-server",
  "version": "0.2.4",
  "mcpName": "io.github.arsalmurad/conformo",
  "description": "MCP server for EU e-invoices (XRechnung, ZUGFeRD / Factur-X, Peppol BIS, UBL, CII): create, validate against the official KoSIT and CEN rules, convert and parse. Runs locally, free, no API key.",
  "author": "Muhammad Arsal Murad",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arsalmurad/conformo.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/arsalmurad/conformo/tree/main/packages/mcp-server#readme",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "e-invoicing",
    "e-rechnung",
    "xrechnung",
    "zugferd",
    "factur-x",
    "peppol",
    "en16931",
    "kosit",
    "invoice",
    "agent"
  ],
  "type": "module",
  "bin": {
    "conformo-mcp": "./src/server.ts"
  },
  "scripts": {
    "build": "node ../../tools/clean-dist.mjs && tsc -p tsconfig.build.json && node ../../tools/write-dist-manifest.mjs ."
  },
  "dependencies": {
    "@conformo/schema": "^0.2.0",
    "@conformo/toolkit": "^0.2.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "exports": {
    ".": "./src/createServer.ts"
  },
  "main": "./src/createServer.ts"
}
